# Copy to .env (never commit .env). Every setting is optional - the app runs without any.

# Live mandi prices from data.gov.in (Agmarknet). Get a free key at https://data.gov.in
# (Sign up -> My Account -> API key). Leave empty to switch the feature off.
DATA_GOV_IN_API_KEY=

# Allow other origins to call the API (comma-separated). Empty = same-origin only.
CORS_ORIGINS=

# Requests per minute per client IP for the live weather/price endpoints.
LIVE_RATE_LIMIT_PER_MINUTE=60

# Which reverse proxies may set X-Forwarded-For (read by uvicorn). Use "*" only behind a trusted proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

LOG_LEVEL=INFO
